# Copy to .env and fill in. Never commit .env.

# --- Security -------------------------------------------------------------------
# Long random string; used to hash session tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# First administrator (created on first start only). If ADMIN_PASSWORD is empty a random one is
# generated and written to /data/INITIAL_ADMIN_PASSWORD.txt inside the data volume.
ADMIN_EMAIL=admin@ossa.studio
ADMIN_PASSWORD=
SESSION_HOURS=72

# --- AI providers (server-side only; never exposed to browsers or exports) -----
# An OpenAI *API* key from platform.openai.com. A ChatGPT subscription does NOT include API access.
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_TIMEOUT_S=300

# --- Limits ---------------------------------------------------------------------
MAX_UPLOAD_MB=60
MAX_IMAGE_PIXELS=40000000
MAX_CONCURRENT_JOBS=2
MAX_COST_PER_JOB_USD=1.00
DEFAULT_PROJECT_BUDGET_USD=25

# --- Storage --------------------------------------------------------------------
# Default: SQLite inside the data volume. A PostgreSQL URL also works, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/imagesynth  (add psycopg[binary] to requirements)
DATABASE_URL=
SEED_REFERENCE_PROJECT=1

# --- Deployment -----------------------------------------------------------------
PORT=8000
# For `docker compose --profile https up -d`
DOMAIN=
